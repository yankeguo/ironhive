FROM golang:1.27 AS builder
ENV CGO_ENABLED=0
WORKDIR /go/src/app
COPY . .
RUN go build -trimpath -ldflags="-s -w" -o /ironhive-agent ./cmd/ironhive-agent

FROM busybox:latest
COPY --from=builder /ironhive-agent /ironhive-agent
# This image is not meant to run a workload itself: it is used as an
# initContainer that copies /ironhive-agent into a shared emptyDir (see
# config.yml), so it intentionally has no ENTRYPOINT — only the static
# binary and busybox's shell for the copy command.
