FROM golang:1.27 AS builder
ENV CGO_ENABLED=0
WORKDIR /go/src/app
COPY . .
RUN go build -trimpath -ldflags="-s -w" -o /ironhive-agent ./cmd/ironhive-agent

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
	ca-certificates \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=builder /ironhive-agent /ironhive-agent
ENV IHA_LISTEN=:19173
EXPOSE 19173
# ironhive-agent acts as PID 1 itself (zombie reaping), no tini needed.
ENTRYPOINT ["/ironhive-agent"]
