FROM oven/bun:1 AS static
# Mirror the repo layout: main.css's tailwind @source glob ("../../../*.go")
# scans the controller Go files, so they must sit at /repo/controller —
# resolving past them (to the container root /) walks the whole filesystem
# (/proc, /usr, ...) and the build hangs forever.
WORKDIR /repo/controller/web
COPY controller/web/package.json controller/web/bun.lock ./
RUN bun install --frozen-lockfile
COPY controller/web/ ./
COPY controller/*.go /repo/controller/
RUN bun run build

FROM golang:1.27 AS builder
ENV CGO_ENABLED=0
WORKDIR /go/src/app
COPY . .
COPY --from=static /repo/controller/web/dist controller/web/dist
RUN go build -trimpath -ldflags="-s -w" -o /ironhive-controller ./cmd/ironhive-controller

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
	tini \
	ca-certificates \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=builder /ironhive-controller /ironhive-controller
EXPOSE 8080
ENTRYPOINT ["tini", "--"]
CMD ["/ironhive-controller"]
